{
  "name": "proton-mail-mcp",
  "version": "0.5.3",
  "private": true,
  "description": "Local Proton Mail Bridge MCP server with read-only mail intelligence, explicit dry-run-by-default triage mutations, controlled RFC 8058 one-click unsubscribe, controlled plain-text-only SMTP sending, and controlled reply/forward (loopback-only Bridge transport, receipt-gated, at-most-once per attempt; live reply enabled with real Bridge validation pending after a full MCP restart, live forward disabled).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "imapflow": "^2.0.5",
    "nodemailer": "^10.0.10",
    "postal-mime": "^3.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
